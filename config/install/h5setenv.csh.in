# help@hdfgroup.org.
#
# Set up the environment for this HDF5 installation so that the tools are
# on PATH and the filter plugins in @HDF5_INSTALL_LIB_DIR@/plugin can be found.
#
# This file must be sourced, not executed, from csh or tcsh:
#
#   source <install dir>/@HDF5_INSTALL_BIN_DIR@/h5setenv.csh
#
# If the shell cannot report the location of this script (for example when
# sourced from a non-interactive csh), pass the install directory instead:
#
#   source <install dir>/@HDF5_INSTALL_BIN_DIR@/h5setenv.csh <install dir>
#
# Errors jump to the end of the file instead of calling exit, which would
# close the shell that sourced this file.

# Locate the install directory: from an argument, or from the source command
# line that tcsh stores in $_
set _h5_prefix = ""
if ($#argv > 0) then
    set _h5_prefix = "$argv[1]"
else if ($?_) then
    set _h5_cmd = ($_)
    if ($#_h5_cmd >= 2) then
        set _h5_prefix = "$_h5_cmd[2]:h/.."
    endif
    unset _h5_cmd
endif

if ("$_h5_prefix" == "") then
    echo "h5setenv.csh: cannot determine install directory; use: source <install dir>/@HDF5_INSTALL_BIN_DIR@/h5setenv.csh <install dir>"
    goto h5setenv_done
endif
if (! -d "$_h5_prefix/@HDF5_INSTALL_BIN_DIR@") then
    echo "h5setenv.csh: $_h5_prefix is not an HDF5 install directory"
    goto h5setenv_done
endif
set _h5_prefix = `cd "$_h5_prefix" && pwd`

setenv PATH "${_h5_prefix}/@HDF5_INSTALL_BIN_DIR@:${PATH}"
# HDF5_PLUGIN_PATH replaces the built-in default search path, so keep any
# paths that are already set after this installation's plugin directory
if ($?HDF5_PLUGIN_PATH) then
    setenv HDF5_PLUGIN_PATH "${_h5_prefix}/@HDF5_INSTALL_LIB_DIR@/plugin:${HDF5_PLUGIN_PATH}"
else
    setenv HDF5_PLUGIN_PATH "${_h5_prefix}/@HDF5_INSTALL_LIB_DIR@/plugin"
endif

h5setenv_done:
unset _h5_prefix

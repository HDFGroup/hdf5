<?xml version="1.0" encoding="UTF-8"?>
<!-- WixUI_FeatureTree with one added page, after the feature tree on a first
     install, that has a checkbox for adding the plugin directory to the system
     HDF5_PLUGIN_PATH variable. The checkbox sets ADD_HDF5_PLUGIN_PATH, which
     is the condition on the HDF5PluginPathEnv component in patch.xml.in. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <!-- Unchecked by default; checked when an earlier install of this
             version wrote the registry value. -->
        <Property Id="ADD_HDF5_PLUGIN_PATH" Secure="yes">
            <RegistrySearch Id="HDF5PluginPathSearch"
                 Root="HKLM"
                 Key="Software\@CPACK_PACKAGE_VENDOR@\@CPACK_PACKAGE_NAME@\@CPACK_PACKAGE_VERSION@"
                 Name="PluginPathEnv"
                 Type="raw"/>
        </Property>

        <UI Id="HDF5_WixUI_FeatureTree">
            <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8"/>
            <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12"/>
            <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes"/>

            <Property Id="DefaultUIFont" Value="WixUI_Font_Normal"/>
            <Property Id="WixUI_Mode" Value="FeatureTree"/>

            <DialogRef Id="ErrorDlg"/>
            <DialogRef Id="FatalError"/>
            <DialogRef Id="FilesInUse"/>
            <DialogRef Id="MsiRMFilesInUse"/>
            <DialogRef Id="PrepareDlg"/>
            <DialogRef Id="ProgressDlg"/>
            <DialogRef Id="ResumeDlg"/>
            <DialogRef Id="UserExit"/>

            <Dialog Id="HDF5PluginPathDlg" Width="370" Height="270" Title="!(loc.CustomizeDlg_Title)">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.CustomizeDlgBannerBitmap)"/>
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
                <Control Id="Title" Type="Text" X="15" Y="6" Width="210" Height="15" Transparent="yes" NoPrefix="yes"
                     Text="{\WixUI_Font_Title}Plugin Search Path"/>
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                     Text="Choose whether to set the HDF5_PLUGIN_PATH environment variable."/>
                <Control Id="Text" Type="Text" X="25" Y="60" Width="320" Height="40" NoPrefix="yes"
                     Text="This HDF5 installation finds filter plugins in its own plugin folder without any setting. Setting HDF5_PLUGIN_PATH lets other HDF5 applications and libraries on this computer find them too."/>
                <Control Id="PluginDir" Type="Text" X="35" Y="102" Width="310" Height="15" NoPrefix="yes"
                     Text="[INSTALL_ROOT]lib\plugin"/>
                <Control Id="Warning" Type="Text" X="25" Y="124" Width="320" Height="30" NoPrefix="yes"
                     Text="When HDF5_PLUGIN_PATH is set, HDF5 searches only the folders it lists. If you are not sure, leave this box unchecked."/>
                <Control Id="PluginPathCheckBox" Type="CheckBox" X="25" Y="162" Width="320" Height="17"
                     Property="ADD_HDF5_PLUGIN_PATH" CheckBoxValue="1"
                     Text="Add this folder to the system HDF5_PLUGIN_PATH variable"/>
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)"/>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)"/>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>

            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>

            <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
            <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg">LicenseAccepted = "1"</Publish>

            <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="1">Installed</Publish>
            <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" Order="2">NOT Installed</Publish>
            <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="HDF5PluginPathDlg" Order="1">NOT Installed</Publish>
            <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2">Installed</Publish>

            <Publish Dialog="HDF5PluginPathDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg">1</Publish>
            <Publish Dialog="HDF5PluginPathDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>

            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="HDF5PluginPathDlg" Order="1">NOT Installed</Publish>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg" Order="2">Installed AND WixUI_InstallMode = "Change"</Publish>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="3">Installed AND NOT PATCH AND NOT WixUI_InstallMode = "Change"</Publish>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="4">Installed AND PATCH</Publish>

            <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>

            <Publish Dialog="MaintenanceTypeDlg" Control="ChangeButton" Event="NewDialog" Value="CustomizeDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
        </UI>

        <UIRef Id="WixUI_Common"/>
    </Fragment>
</Wix>

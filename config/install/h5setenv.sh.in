# help@hdfgroup.org.
#
# Set up the environment for this HDF5 installation so that the tools are
# on PATH and the filter plugins in @HDF5_INSTALL_LIB_DIR@/plugin can be found.
#
# This file must be sourced, not executed, from bash or zsh:
#
#   . <install dir>/@HDF5_INSTALL_BIN_DIR@/h5setenv.sh
#

# Locate this script when sourced
if [ -n "${BASH_SOURCE:-}" ]; then
    _h5_script="${BASH_SOURCE}"
    if [ "${BASH_SOURCE}" = "$0" ]; then
        echo "h5setenv.sh must be sourced: . ${_h5_script}" >&2
        unset _h5_script
        exit 1
    fi
elif [ -n "${ZSH_VERSION:-}" ]; then
    eval '_h5_script="${(%):-%x}"'
else
    echo "h5setenv.sh: unsupported shell; use bash or zsh, or set HDF5_PLUGIN_PATH manually" >&2
    return 1 2>/dev/null || exit 1
fi

_h5_prefix="$(cd "$(dirname "${_h5_script}")/.." && pwd)"

export PATH="${_h5_prefix}/@HDF5_INSTALL_BIN_DIR@${PATH:+:${PATH}}"
# HDF5_PLUGIN_PATH replaces the built-in default search path, so keep any
# paths that are already set after this installation's plugin directory
export HDF5_PLUGIN_PATH="${_h5_prefix}/@HDF5_INSTALL_LIB_DIR@/plugin${HDF5_PLUGIN_PATH:+:${HDF5_PLUGIN_PATH}}"

unset _h5_script _h5_prefix
